# ──────────────────────────────────────────────────────────────────────────────
# Gerrit (SSH)
# ──────────────────────────────────────────────────────────────────────────────

# SSH username for authenticating with the Gerrit server.
GERRIT_SSH_USER=your-username

# Absolute path to the SSH private key authorised for the Gerrit account above.
GERRIT_SSH_KEY=/home/your-username/.ssh/id_rsa

# ──────────────────────────────────────────────────────────────────────────────
# GitHub
# ──────────────────────────────────────────────────────────────────────────────

# Personal access token (or a fine-grained token) with at least read:org scope
# so the app can list team repositories and read commit history.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────────────────────────────────────
# Confluence
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of the Confluence instance (no trailing slash).
CONFLUENCE_URL=https://your-org.atlassian.net/wiki

# Confluence account email address used for Basic authentication.
CONFLUENCE_USERNAME=your-email@example.com

# Confluence API token generated at https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=your-confluence-api-token

# ID of the Confluence page to read the project table from.
# Find it in the page URL: /wiki/spaces/SPACE/pages/<PAGE_ID>/...
CONFLUENCE_PAGE_ID_READ=000000000

# ID of the Confluence page to write results back to (may differ from the read page).
CONFLUENCE_PAGE_ID_WRITE=000000000

# ──────────────────────────────────────────────────────────────────────────────
# JSON adapter file paths (used when spring.profiles.active=json)
# ──────────────────────────────────────────────────────────────────────────────

# Path to the JSON file listing Gerrit repositories.
JSON_GERRIT_FILE=data/gerrit-repositories.json

# Path to the JSON file listing GitHub repositories.
JSON_GITHUB_FILE=data/github-repositories.json

# Path to the JSON file used as the Confluence read source.
JSON_CONFLUENCE_FILE_READ=data/confluence-data.json

# Path to the JSON file where Confluence write output is stored.
JSON_CONFLUENCE_FILE_WRITE=data/confluence-data-out.json
